# Inbound OAuth (from Gemini Enterprise via your IdP)
OAUTH_INTROSPECT_URL=https://your-idp.example.com/oauth2/v1/introspect
OAUTH_CLIENT_ID=replace-me
OAUTH_CLIENT_SECRET=replace-me

# Snowflake outbound (service-account key-pair auth)
SNOWFLAKE_ACCOUNT=acme-corp
SNOWFLAKE_USER=AGENT_SVC
SNOWFLAKE_WAREHOUSE=AGENT_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_ROLE=AGENT_READER

# Secret Manager resource names. PASSPHRASE is optional (only if the key is encrypted).
SNOWFLAKE_PRIVATE_KEY_SECRET=projects/PROJECT/secrets/snowflake-agent-key/versions/latest
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_SECRET=projects/PROJECT/secrets/snowflake-agent-key-pass/versions/latest
